# 開発画面のURL。Google/LINEにもこのURLを元にコールバックを登録します。
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3001
API_HOST=127.0.0.1
# 本番のHTTPSプロキシの接続元IP/CIDRだけを指定。例: 127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
DATABASE_PATH=.data/kotoba.sqlite
# Supabase等のPostgreSQLを使う場合に設定。未指定時はローカルSQLiteを使用。
DATABASE_URL=
# DATABASE_URL に [YOUR-PASSWORD] を残す場合、この欄へ実際のDBパスワードを設定します。
DATABASE_PASSWORD=
# 無料ホスティングで誤って一時ディスクに保存することを防ぐ設定。
REQUIRE_POSTGRES=false
# ローカルでは未指定なら .data/auth-secret に自動生成。本番は32文字以上の乱数を必ず指定。
BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# 設定するとメール確認必須になります。公開時は必須。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# HTTPS APIでメールを送信する場合（SMTPとの同時設定は不可）
# RailwayのHobby等、SMTP接続が利用できない公開先でも使用可能。
RESEND_API_KEY=
MAIL_FROM=

# 独自ドメインなしで無料テストする場合のHTTPSメールAPI（Resend・SMTPとの同時設定は不可）
# Brevoで確認済みの送信者メールアドレスを設定します。
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Kotoba Flashcards

# 資料から単語をAI生成する機能。未設定でも通常の単語帳は利用できます。
# サーバー専用。VITE_ を付けず、ブラウザーやGitにAPIキーを公開しないでください。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# UTCの1日あたり生成試行回数。失敗・中止も含む。Gemini無料枠にも別途利用上限があります。
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=50
