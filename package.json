{
  "name": "kotoba-flashcards",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node build/server.mjs",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=build/server.mjs",
    "share:zip": "node scripts/create-share-zip.mjs",
    "share:verify": "node scripts/verify-share-zip.mjs",
    "backup": "node scripts/backup-sqlite.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "ai:smoke": "tsx scripts/test-ai-generation.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src server index.html package.json tsconfig*.json vite.config.ts eslint.config.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "express": "^5.2.1",
    "html-to-text": "^10.0.1",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "1.47.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
